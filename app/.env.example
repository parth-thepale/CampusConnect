# ==============================================================================
# CampusConnect Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit .env or service account keys to version control.
# ==============================================================================

# Server configuration
PORT=8080
NODE_ENV=development

# Google Cloud / Firebase Project Configuration
# When deployed to Cloud Run or running with Application Default Credentials (ADC),
# GOOGLE_CLOUD_PROJECT is automatically populated by the runtime environment.
GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=

# Firebase Emulators (Optional for local testing without cloud credentials)
# FIRESTORE_EMULATOR_HOST=localhost:8085
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Development-only authentication override (STRICTLY PROHIBITED in production)
# When true and NODE_ENV !== 'production', permits x-dev-user-id and x-dev-user-role headers
# for manual testing when Firebase ID tokens are unavailable.
ALLOW_DEV_AUTH=false

# In-Memory Repository (Optional for testing or zero-config development)
# When true, uses in-memory data store instead of Cloud Firestore.
# In production (NODE_ENV=production), this setting is strictly forbidden.
USE_IN_MEMORY_REPO=false

# ==============================================================================
# Google Gemini AI API Configuration (Server-Side Only - Phase 2)
# ==============================================================================
# NEVER prefix with VITE_ or expose to client code.
# In Cloud Run, supply via Secret Manager or Cloud Run environment secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ==============================================================================
# Email OTP Authentication Configuration (Phase 3 Pre-Frontend)
# ==============================================================================
# Secret used to HMAC-SHA256 hash the 6-digit OTP in the database
AUTH_EMAIL_OTP_SECRET=

# SMTP Delivery Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusConnect <noreply@campusconnect.edu>

# Temporary Authentication Diagnostic Test Page (Set true only for auth verification)
AUTH_TEST_PAGE_ENABLED=false

# Firebase Web Client configuration (Public config used by the test page)
FIREBASE_CLIENT_API_KEY=
FIREBASE_CLIENT_AUTH_DOMAIN=
FIREBASE_CLIENT_PROJECT_ID=
FIREBASE_CLIENT_STORAGE_BUCKET=
FIREBASE_CLIENT_MESSAGING_SENDER_ID=
FIREBASE_CLIENT_APP_ID=
