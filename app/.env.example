# ==============================================================================
# CampusConnect Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit .env or private credentials to version control.
# ==============================================================================

# Server configuration
PORT=8080
NODE_ENV=development

# ==============================================================================
# Database Configuration (PostgreSQL / Supabase / Cloud SQL)
# ==============================================================================
# Direct connection string for PostgreSQL.
# For Supabase project 'liwhtuyufhlrkkoienru':
# postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Or direct host:
# postgresql://postgres:[YOUR-PASSWORD]@db.liwhtuyufhlrkkoienru.supabase.co:5432/postgres
DATABASE_URL=

# ==============================================================================
# Authentication & Security Tokens
# ==============================================================================
# Random 32+ character secret string used to sign backend session JWTs
JWT_SECRET=campusconnect-jwt-default-secret-2026

# Secret salt used to HMAC-SHA256 hash 6-digit OTP codes in the database
AUTH_EMAIL_OTP_SECRET=campusconnect-dev-otp-secret-key-32b

# Optional: Google OAuth Web Client ID (for Google Identity Services verification)
GOOGLE_CLIENT_ID=

# Development-only authentication override (STRICTLY PROHIBITED in production)
ALLOW_DEV_AUTH=false

# In-Memory Repository (Optional for testing or zero-config development)
USE_IN_MEMORY_REPO=false

# ==============================================================================
# Google Gemini AI API Configuration (Server-Side Only)
# ==============================================================================
# Required for AI clarification, summarization, and duplicate detection
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ==============================================================================
# Email OTP Delivery (SMTP)
# ==============================================================================
# Required for sending 6-digit verification codes to campus emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusConnect <noreply@campusconnect.edu>

# Optional: CORS allowed origins (comma-separated URLs, e.g. https://your-frontend.com)
CORS_ALLOWED_ORIGINS=
