# ==============================================================================
# CampusConnect Frontend - Environment Variables (Vite)
# ==============================================================================
# Optional public client variables.
# By default, frontend connects to backend on same origin (/api/*).
#
# NEVER put server secrets (Gemini API keys, database credentials, SMTP passwords)
# into frontend environment variables!
# ==============================================================================

# Optional Google OAuth Client ID for Google Identity Services button
VITE_GOOGLE_CLIENT_ID=
