# ==============================================================================
# CampusConnect Frontend - Environment Variables (Vite)
# ==============================================================================
# In production, these public Firebase web credentials allow the client to
# initialize Firebase Authentication and Google Sign-In.
#
# NEVER put server secrets (Gemini API keys, SMTP credentials, service account JSON)
# into frontend environment variables!
# ==============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=campusconnect-512507
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
