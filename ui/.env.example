# Server-side only — set as an AI Studio Secret or Cloud Run secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local SQLite database. It is durable on your computer but is not durable on Cloud Run.
DATABASE_PATH=./data/campusconnect.db
# Enables seeded local accounts and local-session authentication.
DEMO_MODE=true
